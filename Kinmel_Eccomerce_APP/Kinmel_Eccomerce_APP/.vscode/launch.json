{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Django: Run Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver", "127.0.0.1:8080"],
            "django": true,
            "justMyCode": true,
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        },
        {
            "name": "Django: Debug Server",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/manage.py",
            "args": ["runserver", "127.0.0.1:8080", "--noreload"],
            "django": true,
            "justMyCode": false,
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        }
    ]
}
